.fvec projection[4]
.fvec tint
.fvec bones[90]
.out outpos position
.out outclr color
.out outuv texcoord0
.alias inpos v0
.alias inclr v1
.alias inuv v2
.proc main
 mova a0.x, inuv.z
 dp4 r0.x, bones[a0.x], inpos
 dp4 r0.y, bones[a0.x+1], inpos
 dp4 r0.z, bones[a0.x+2], inpos
 mov r0.w, inpos.w
 dp4 outpos.x, projection[0], r0
 dp4 outpos.y, projection[1], r0
 dp4 outpos.z, projection[2], r0
 dp4 outpos.w, projection[3], r0
 mul outclr, tint, inclr
 mov outuv, inuv
 end
.end
