.fvec projection[4]
.fvec tint
.out outpos position
.out outclr color
.out outuv texcoord0
.alias inpos v0
.alias inclr v1
.alias inuv v2
.proc main
 dp4 outpos.x, projection[0], inpos
 dp4 outpos.y, projection[1], inpos
 dp4 outpos.z, projection[2], inpos
 dp4 outpos.w, projection[3], inpos
 mul outclr, tint, inclr
 mov outuv, inuv
 end
.end
